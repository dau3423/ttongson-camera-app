rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 클라이언트는 어떤 문서도 직접 읽거나 쓸 수 없다.
    // advise Cloud Function은 Admin SDK로 접근하므로 이 규칙을 우회한다.
    // (rate_limits 카운터를 클라이언트가 조작하지 못하게 막는다.)
    // 사용자 프로필: 로그인 사용자는 읽기, 본인 문서만 생성/수정.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
    }
    // 게시물: 로그인 사용자 읽기, 작성자만 생성. 카운터/hidden은 함수 전용.
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.likeCount == 0
                    && request.resource.data.commentCount == 0
                    && request.resource.data.reportCount == 0
                    && request.resource.data.hidden == false;
      allow update, delete: if false;
      match /likes/{uid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
