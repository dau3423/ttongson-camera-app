{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Bash(flutter *)",
      "Bash(dart *)",
      "Bash(git *)",
      "Bash(tool/verify.sh)",
      "Bash(./tool/verify.sh)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath // empty' | { read -r f; case \"$f\" in *.dart) /Users/soonbok/flutter/bin/dart format \"$f\";; esac; } 2>/dev/null || true",
            "statusMessage": "dart format"
          }
        ]
      }
    ]
  }
}
